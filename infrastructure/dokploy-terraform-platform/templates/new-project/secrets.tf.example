# Complete root for terraform/projects/<project>/secrets, not a fragment.
# Rename every "backend"/"frontend" placeholder to your real component names,
# then copy terraform/bootstrap/secrets/main.tf's terraform{}/provider blocks here
# (required_version, backend "local" {}, the infisical provider requirement and
# `provider "infisical" { host = var.infisical_url, auth = { token = var.infisical_token } }`)
# since every root repeats those verbatim.

variable "infisical_url" {
  type = string
}
variable "infisical_token" {
  type      = string
  sensitive = true
}
variable "infisical_project_id" {
  type = string
}
variable "environment" {
  type = string
  validation {
    condition     = contains(["dev", "prod"], var.environment)
    error_message = "Use dev or prod; environments have separate states."
  }
}
variable "platform" {
  type = string
}
variable "project" {
  type = string
}
variable "credential_version" {
  description = "Increase to regenerate every generated credential in this layer. Edits made in Infisical are otherwise kept."
  type        = number
  default     = 1
}

# One entry per secret this platform can safely generate at apply time.
# "backend" is a stand-in for any component with its own database (e.g. a CMS,
# a REST API). Add one DB_PASSWORD (and any app-specific secret keys) per
# DB-backed component.
locals {
  generated = {
    "backend/DB_PASSWORD" = "backend"
    "backend/APP_SECRET"  = "backend"
  }
  # Operator-supplied values that come from tfvars, not generated. Add OIDC
  # client credentials, admin emails, or any other human-provided value here.
  configured = {
    # "backend/ADMIN_EMAIL" = var.backend_admin_email
  }
}

resource "infisical_secret_folder" "project" {
  project_id       = var.infisical_project_id
  environment_slug = var.environment
  folder_path      = "/"
  name             = var.project
}

# One folder per component. "frontend" has NO generated secret below: its
# read-only API token can only be minted after the backend is deployed and
# must be added to Infisical manually — Terraform only reserves the path.
resource "infisical_secret_folder" "component" {
  for_each         = toset(["backend", "frontend", "runner"])
  project_id       = var.infisical_project_id
  environment_slug = var.environment
  folder_path      = infisical_secret_folder.project.path
  name             = each.key
}

ephemeral "random_password" "generated" {
  for_each = local.generated
  length   = 48
  special  = false
}
resource "infisical_secret" "generated" {
  for_each         = local.generated
  workspace_id     = var.infisical_project_id
  env_slug         = var.environment
  folder_path      = infisical_secret_folder.component[each.value].path
  name             = basename(each.key)
  value_wo         = ephemeral.random_password.generated[each.key].result
  value_wo_version = var.credential_version
}
resource "infisical_secret" "configured" {
  for_each     = toset(keys(local.configured))
  workspace_id = var.infisical_project_id
  env_slug     = var.environment
  folder_path  = infisical_secret_folder.component[dirname(each.key)].path
  name         = basename(each.key)
  value        = local.configured[each.key]
}

output "folders" {
  value = { for name, folder in infisical_secret_folder.component : name => folder.path }
}
