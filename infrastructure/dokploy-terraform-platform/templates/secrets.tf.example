# Fragment for terraform/projects/<project>/secrets, not a complete root.
# Declare project, environment, infisical_project_id, credential_version,
# provider authentication, and project/component folders as in an existing project's secrets root.
ephemeral "random_password" "service_db" {
  length  = 48
  special = false
}

resource "infisical_secret" "service_db" {
  workspace_id     = var.infisical_project_id
  env_slug         = var.environment
  folder_path      = infisical_secret_folder.component["SERVICE_SLUG"].path
  name             = "DB_PASSWORD"
  value_wo         = ephemeral.random_password.service_db.result
  value_wo_version = var.credential_version
}
