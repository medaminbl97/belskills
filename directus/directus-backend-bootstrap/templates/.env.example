# Copy to .env (or run `node tools/init-env.mjs`, which fills random values).
DIRECTUS_PORT=8055
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DB_PASSWORD=
SECRET=

# dev (default) also loads seeds/examples; prod loads only seeds/reference.
# Set it explicitly in every deployment.
CMS_ENV=dev

# Never enable in production: publishes example seed rows that are still drafts.
SEED_PUBLISH_DEMO=false

# Origin of the website that reads published content (CORS).
CORS_ORIGIN=http://localhost:3000

# Static token of a managed service user (see access/ in SKILL.md); 32+
# characters. Leave blank to skip that user. Name it after the token_env in its
# access file.
# SERVICE_TOKEN=
